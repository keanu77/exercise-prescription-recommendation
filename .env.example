# 運動處方 AI 建議系統 - 環境變數設定
# 請複製此檔案為 .env 並填入您的 API 金鑰

# ============ 伺服器設定 ============
PORT=3000
NODE_ENV=production

# ============ 安全性設定 ============
# 允許的來源（CORS），多個來源用逗號分隔
# 部署時請修改為您的實際網域
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# ============ AI API 金鑰設定 ============
# 至少需要設定其中一個 API 金鑰才能啟用 AI 功能
# 建議設定 Groq（免費）作為基本款

# Groq API（免費，推薦作為基本款）
# 取得方式: https://console.groq.com/
# 支援模型: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_API_KEY=your_groq_api_key_here

# Claude API (Anthropic)
# 取得方式: https://console.anthropic.com/
# 支援模型: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, claude-3-opus-20240229
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini API (Google)
# 取得方式: https://makersuite.google.com/app/apikey
# 支援模型: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash, gemini-1.0-pro
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API
# 取得方式: https://platform.openai.com/api-keys
# 支援模型: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_API_KEY=your_openai_api_key_here
