# 運動處方推薦系統 - 環境變數
#
# 線上（Cloudflare Pages）：金鑰不放檔案，用 wrangler 設定 Secrets：
#   npx wrangler pages secret put GROQ_API_KEY --project-name exercise-prescription
#   ALLOWED_ORIGINS 等非機密設定在 wrangler.toml 的 [vars]。
#
# 本機（npm run dev）：複製本檔為 .env 並填入金鑰，scripts/dev-server.mjs 會讀取。

# 本機開發伺服器埠號（線上不使用）
PORT=3000

# CORS 跨來源白名單，逗號分隔完整 origin；留空 = 只允許同站呼叫 /api
ALLOWED_ORIGINS=

# ============ AI API 金鑰 ============
# 站方模式目前僅啟用 Groq120B；其他候選模型需使用者自帶金鑰。
# 可用模型清單以 functions/_lib/models.js 的 MODEL_ALLOWLIST 為準。

# Groq — https://console.groq.com/
GROQ_API_KEY=

# Claude (Anthropic) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gemini (Google) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 站方每日美元預算防線（KV 非原子；不等於供應商帳單硬上限）
AI_DAILY_BUDGET_USD=2
